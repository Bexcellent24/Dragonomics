<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/DeepAbyss">

    <!-- Title -->
    <TextView
        android:id="@+id/titleThisMonth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:fontFamily="@font/breathe_fire_iii"
        android:paddingBottom="8dp"
        android:text="THIS MONTH"
        android:textAllCaps="true"
        android:textColor="@color/GoldenEmber"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Three stats row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/labelIncome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/aref_ruqaa"
                android:text="Income"
                android:textColor="@color/GoldenEmber"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/valueIncome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/aref_ruqaa"
                android:text="R0"
                android:textColor="@color/GoldenEmber"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/labelExpenses"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/aref_ruqaa"
                android:text="Expenses"
                android:textColor="@color/GoldenEmber"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/valueExpenses"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/aref_ruqaa"
                android:text="R0"
                android:textColor="@color/GoldenEmber"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/labelRemaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/aref_ruqaa"
                android:text="Remaining"
                android:textColor="@color/GoldenEmber"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/valueRemaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/aref_ruqaa"
                android:text="R0"
                android:textColor="@color/GoldenEmber"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Goal bar -->
    <com.TheBudgeteers.dragonomics.ui.widgets.GoalBarView
        android:id="@+id/goalBar"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="2dp" />

    <!-- Min / Max labels under the bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/minGoalText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/aref_ruqaa"
            android:text="Min Goal: R0"
            android:textColor="@color/GoldenEmber"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/maxGoalText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/aref_ruqaa"
            android:text="Max Goal: R0"
            android:textColor="@color/GoldenEmber"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
